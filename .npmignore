# Exclude secrets and local config
.mcpregistry_*
.env
.env.*
# NPM 2FA artifacts / temp files
npm_recovery_codes.txt
.tmp_server.schema.json
*.schema.json
mcp-publisher

# Do not publish TS sources or tests
src/
tsconfig.json
**/test/**
__tests__/**

# VCS / CI
.git*
.github/

# Node
node_modules/

# Optional: exclude sourcemaps
**/*.map

# Local HTTPS certificate and private key generated during setup
.certs/

# Generated plugin bundles (use the packaging workflow artifacts)
artifacts/

# CLI/MCP mutable runtime state and generated npm archives
patterns/canary-state.json
patterns/canary-state.json.tmp
patterns/feed-cache/
patterns/staging/
*.tgz
