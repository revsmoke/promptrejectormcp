{
  "version": 1,
  "patterns": [
    {
      "id": "policy-puppetry-xml-system",
      "name": "Fake XML/HTML system/policy tag wrapper",
      "description": "XML/HTML-style fake system/policy tag wrapping (HiddenLayer Policy Puppetry, Apr 2025)",
      "pattern": "<\\s*(system|policy|instructions?|developer_message|admin_message|role)\\s*>[\\s\\S]{1,}?<\\s*/\\s*\\1\\s*>",
      "flags": "gi",
      "severity": "critical",
      "category": "policy_puppetry",
      "flagGroup": "hasPolicyPuppetry",
      "scope": "general",
      "detection": {
        "mode": "simple"
      },
      "enabled": true,
      "source": "original",
      "cveRefs": [],
      "dateAdded": "2026-05-13",
      "whitelistedDomains": [],
      "atlasTechnique": "AML.T0054"
    },
    {
