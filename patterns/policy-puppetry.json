      "pattern": "^\\s*\\[(policy|system|instructions?|admin_rules?|admin_message|developer_message)\\]\\s*$[\\s\\S]{0,500}?\\b(override|ignore|priority|allow|bypass|jailbreak)\\s*[:=]",
