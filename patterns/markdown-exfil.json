{
  "version": 1,
  "patterns": [
    {
      "id": "markdown-image-exfil-query",
      "name": "Markdown image with suspicious query string",
      "description": "Markdown image with long opaque query value — common exfil vector (data leak via image-fetch)",
      "pattern": "!\\[[^\\]]*\\]\\(https?://[^\\)\\s]+[?&][^=]+=[A-Za-z0-9_+/=%-]{16,}\\)",
      "flags": "gi",
      "severity": "critical",
      "category": "markdown_exfil",
      "flagGroup": "hasMarkdownExfil",
      "scope": "general",
      "detection": {
        "mode": "simple"
      },
      "enabled": true,
      "source": "original",
      "cveRefs": [],
      "dateAdded": "2026-05-13",
      "whitelistedDomains": [],
      "atlasTechnique": "AML.T0024"
    },
    {
      "id": "markdown-javascript-uri",
      "name": "Markdown link/image with javascript: URI",
      "description": "Markdown link/image with javascript: URI — XSS + agent-hijack vector",
