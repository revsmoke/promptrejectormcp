# Prompt Rejector Configuration
# Copy this file to .env and fill in your values

# Legacy default semantic/pattern provider: Google AI API key
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_key_here
# TypeSafe key; merely setting this does not enable judgment routes
TYPESAFE_API_KEY=your_typesafe_ai_key_here
# Optional: API server port (default: 3000)
PORT=3000

# Optional: Startup mode
# Options: "api" (REST only), "mcp" (MCP only), "both" (default)
START_MODE=both

# Optional: Secret for HMAC signing of the pattern library manifest
# When set, PatternService verifies the HMAC signature on startup.
# Without this, SHA-256 file hashes still verify integrity but not authenticity.
PATTERN_INTEGRITY_SECRET=

# Optional: GitHub personal access token for advisory feed scanning
# Increases rate limit from 60/hr to 5000/hr for GitHub Advisory API
GITHUB_TOKEN=

# Optional: NVD API key for vulnerability feed scanning
# Increases rate limit from 5/30s to 50/30s for NVD CVE API
# Get one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional: Allowed CORS origins (default: all origins)
# Use comma-separated values for multiple: "https://app.example.com,https://admin.example.com"
CORS_ORIGIN=

# --- v1.1.0 additions ---

# Optional: Hugging Face Hub token for the scan_skill HF security-flag lookup
# Anonymous reads work but rate limits are tighter. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# NOTE: AtlasService and KevFeedService currently use hardcoded TTLs (7 days
# and 24 hours respectively), configurable only via constructor opts. These
# env vars are reserved for a future pass that wires them through; setting
# them today has no effect.
# ATLAS_REFRESH_INTERVAL_HOURS=168
# KEV_REFRESH_INTERVAL_HOURS=24

# --- Taste-Tester (taste_test MCP tool) ---
# Opt-in dual-agent sandbox detonator. Disabled by default because every call
# spends provider API budget. Enable only when you want dynamic detection.
TASTE_TESTER_ENABLED=false
# Anthropic API key — required only for selected Claude roles (legacy Taster/Monitor defaults)
ANTHROPIC_API_KEY=
# Legacy model for Taster and Monitor when AI_CONFIG_PATH is absent.
# An explicit AI config selects all roles independently.
TASTE_TESTER_MODEL=claude-opus-4-7
# Per-call hard caps (defaults shown)
TASTE_TESTER_MAX_TURNS=5
TASTE_TESTER_MAX_TOKENS=4096
TASTE_TESTER_TIMEOUT_MS=30000

# --- Canary tokens (deploy_canary / verify_canary) ---
# Optional HMAC secret for patterns/canary-state.json. Falls back to
# PATTERN_INTEGRITY_SECRET if unset; if both are unset, state is stored unsigned.
CANARY_HMAC_SECRET=
# Default time-to-live for issued canary tokens (default 86400 = 24h)
CANARY_DEFAULT_TTL_SECONDS=86400

# --- Configurable model roles ---
# start:mcp defaults to config/ai.active.json (TypeSafe active, MCP v2).
# Copy that file to customize active roles, or ai.example.json for an off-first rollout.
# Paths for capability/pricing files are relative to the AI config file.
# Explicit config takes precedence over legacy TASTE_TESTER_MODEL.
AI_CONFIG_PATH=
# Optional; required only by selected OpenAI profiles.
OPENAI_API_KEY=
# Inspect configuration without inference: npm run ai:config
# Live synthetic probe (explicit budget; not quality qualification):
# npm run ai:probe -- --live --profile claude-semantic --pricing config/ai-pricing.example.json --max-requests 2 --max-usd 1
